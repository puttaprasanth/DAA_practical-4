#include <iostream>
#include <chrono>
unsigned long long factorialIterative(int n) {
    if (n < 0) return 0; 
    
    unsigned long long result = 1;
    for (int i = 2; i <= n; ++i) {
        result *= i;
    }
    return result;
}

unsigned long long factorialRecursive(int n) {
    if (n < 0) return 0;
    if (n <= 1) return 1;
    
    return n * factorialRecursive(n - 1); 
}

int main() {
    int num = 20;

    std::cout << "Calculating " << num << "! ...\n\n";
    auto startIter = std::chrono::high_resolution_clock::now();
    unsigned long long iterResult = factorialIterative(num);
    auto endIter = std::chrono::high_resolution_clock::now();
    std::chrono::duration<double, std::nano> iterDuration = endIter - startIter;

    std::cout << "[Iterative Result]: " << iterResult << "\n";
    std::cout << "[Iterative Execution Time]: " << iterDuration.count() << " ns\n\n";
    auto startRec = std::chrono::high_resolution_clock::now();
    unsigned long long recResult = factorialRecursive(num);
    auto endRec = std::chrono::high_resolution_clock::now();
    std::chrono::duration<double, std::nano> recDuration = endRec - startRec;

    std::cout << "[Recursive Result]: " << recResult << "\n";
    std::cout << "[Recursive Execution Time]: " << recDuration.count() << " ns\n";

    return 0;
}


